# ============================================================
# AI Space 环境变量示例
# 复制本文件为 .env.local 并填入真实配置： cp .env.example .env.local
# 修改环境变量后需重启开发服务器
# ============================================================

# 模型服务商 API Key（仅在服务端读取，不会下发到浏览器）
AI_API_KEY=sk-your-key-here

# API Base URL，兼容 OpenAI Chat Completions 协议的服务商根地址
# 官方：https://api.openai.com/v1
# 代理或第三方网关请填写对应地址（末尾不要带 /chat/completions）
AI_BASE_URL=https://api.openai.com/v1

# 模型 ID，必须是你的服务商账号下实际可用的模型
AI_MODEL=gpt-4o-mini
